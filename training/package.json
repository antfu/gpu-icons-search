{
  "name": "@gpu-icons-search/training",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Offline pipeline: data, benchmark, training, evaluation and promotion",
  "scripts": {
    "data": "tsx src/data.ts",
    "targets": "tsx src/targets.ts",
    "train": "uv run --locked python torch/train.py",
    "bench:build": "tsx src/bench/build.ts",
    "bench": "tsx src/bench/run.ts",
    "bench:teachers": "tsx src/bench/teachers.ts",
    "bench:model": "tsx src/bench/model.ts",
    "test:python": "uv run --locked pytest -q",
    "lint:python": "uv run --locked ruff check torch",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@carbon/icons": "catalog:data",
    "@fortawesome/fontawesome-free": "catalog:data",
    "@huggingface/transformers": "catalog:training",
    "@iconify/json": "catalog:data",
    "@mdi/svg": "catalog:data",
    "@phosphor-icons/core": "catalog:data",
    "@primer/octicons": "catalog:data",
    "@tabler/icons": "catalog:data",
    "@types/node": "catalog:types",
    "fzf": "catalog:training",
    "ionicons": "catalog:data",
    "lucide-static": "catalog:data",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "yaml": "catalog:training"
  }
}
